# Public site URL (used for SEO canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://lumioragems.com

# ---- Coming soon ------------------------------------------------------------
# Defaults to ON: every route serves the holding page and the API answers 503.
# Set to "false" to bring the full site back. Nothing else needs changing.
NEXT_PUBLIC_COMING_SOON=true

# ---- Backend API (Phase 2 ready) -------------------------------------------
# When set, catalogue data is fetched from this backend instead of local data.
# Leave blank in Phase 1 to use the bundled static catalogue.
API_BASE_URL=
API_KEY=

# ---- Transactional email ----------------------------------------------------
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=enquiries@lumioragems.com
ENQUIRY_FROM_EMAIL=website@lumioragems.com

# ---- Currency ---------------------------------------------------------------
# Prices are authored in AUD (the base currency) and converted for display.
# Live rates are fetched server-side from open.er-api.com and cached 6 hours;
# no API key is required. Set to "true" to skip the feed entirely and serve the
# indicative fallback rates in src/lib/currency/rates.ts.
DISABLE_LIVE_RATES=false

# ---- Analytics --------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
